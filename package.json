{
  "name": "lifestyle-desktop",
  "productName": "Lifestyle",
  "version": "1.1.0",
  "description": "Lifestyle Fitness membership management",
  "author": "Lifestyle Fitness",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "import-dump": "tsx scripts/import-pg-dump.ts"
  },
  "dependencies": {
    "@googleapis/drive": "26.0.2",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "electron-updater": "6.8.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mantine/charts": "9.7.2",
    "@mantine/core": "9.7.2",
    "@mantine/dates": "9.7.2",
    "@mantine/form": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@mantine/modals": "9.7.2",
    "@mantine/notifications": "9.7.2",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.104.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "drizzle-kit": "0.31.11",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "mantine-datatable": "9.4.0",
    "postcss": "8.5.30",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.18.20": true,
    "better-sqlite3": false,
    "electron-winstaller": false
  }
}
