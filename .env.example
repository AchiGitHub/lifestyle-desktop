# Google OAuth client for Drive backups (Google Cloud Console → APIs & Services
# → Credentials → Create OAuth client ID → "Desktop app"). Copy this file to
# .env and fill both in before `npm run build:win`. Without them the app works,
# but Settings shows Google Drive backup as unavailable.
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
